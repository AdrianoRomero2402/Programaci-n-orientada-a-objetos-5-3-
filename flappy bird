class Cuadrado {
  PVector pos;
  PVector vel;
  float w, h;
  Cuadrado(float x, float y, float w, float h) {
    this.pos = new PVector(x, y);
    this.vel = new PVector(-3, 0);
    this.w = w;
    this.h = h;
  }
  void mover() {
    pos.add(vel);
  }
  void mostrar() {
    fill( 0,0  , 0);
    rect(pos.x, pos.y, w, h);
  }
}
duplatubos
class DuplaDeTubos {
  Cuadrado sup, inf; 
  float anchoTubo = 50;
  float espacioVacio = 150; 
  DuplaDeTubos(PVector pos_m){
    float altoSup = random(50, height - espacioVacio - 50);
    float altoInf = height - altoSup - espacioVacio;
    sup = new Cuadrado(pos_m.x, 0, anchoTubo, altoSup);
    inf = new Cuadrado(pos_m.x, altoSup + espacioVacio, anchoTubo, altoInf);
  }
  void mover(){
    sup.mover();
    inf.mover();
  }
  void mostrar(){
    sup.mostrar();
    inf.mostrar();
  }
}
pelota
class Pelota {
  PVector pos;
  PVector vel;
  float r;
  Pelota(float x, float y) {
    this.pos = new PVector(x, y);
    this.vel = new PVector(0, 0); 
    this.r = 14/*its your birdday*/; 
  }
    void mover() {
    pos.add(vel);
  }
    void addFuerza(PVector fuerza) {
    vel.add(fuerza);
  }
  void mostrar() {
    fill(255, 255, 0);
    noStroke();
    ellipse(pos.x, pos.y, r * 2, r * 2);
  }
}
