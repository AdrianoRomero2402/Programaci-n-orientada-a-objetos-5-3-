final int INICIO = 0;
final int FLAPPY = 1;
final int PONG = 2;
final int GAME_OVER = 3;
int estadoDelJuego = INICIO;
ArrayList<DuplaDeTubos> tubos;
Pelota bird;
float ultimoPar = 0; 
PVector G = new PVector(0, 2); 
PVector salto = new PVector(0, -999); 
void setup() {
  size(800, 600);
  inicializarFlappy();
}
void draw() {
  background(0);
  if (estadoDelJuego == INICIO) {
    dibujarMenuInicio();
  } 
  else if (estadoDelJuego == FLAPPY) {
    jugarFlappy();
  } 
  else if (estadoDelJuego == PONG) {
    jugarPong();
  } 
  else if (estadoDelJuego == GAME_OVER) {
    dibujarGameOver();
  }
}
void dibujarMenuInicio() {
  textAlign(CENTER, CENTER);
  fill(255);
  textSize(45);
  text("MENÚ PRINCIPAL", width / 2, height / 3);
  textSize(22);
  fill(0, 255, 0);
  text("Presiona [ F ] para jugar a Flappy Bird", width / 2, height / 2);
  fill(0, 200, 255);
  text("Presiona [ P ] para jugar a Pong", width / 2, height / 2 + 50);
}
void dibujarGameOver() {
  textAlign(CENTER, CENTER);
  textSize(50);
  fill(255, 0, 0);
  text("GAME OVER", width / 2, height / 2 - 30);
  textSize(20);
  fill(255);
  text("Lisa It's Your Birthday, Happy Birthday, Lisa", width / 2, height / 2 + 40);
}
void inicializarFlappy() {
  tubos = new ArrayList<DuplaDeTubos>();
  bird = new Pelota(100, height / 2); 
  ultimoPar = millis();
}
void jugarFlappy() {
  agregarTubos(); 
  bird.addFuerza(G); 
  bird.mover();
  for (int i = 0; i < tubos.size(); i++) {
    DuplaDeTubos t = tubos.get(i);
    t.mover();
    t.mostrar(); 
  }
  bird.mostrar();
  if (bird.pos.y > height || bird.pos.y < 0) {
    estadoDelJuego = GAME_OVER;
  }
}
void agregarTubos() { 
  float tActual = millis();
  float dt = tActual - ultimoPar; 
  if (dt > 5000) { 
    tubos.add(new DuplaDeTubos(new PVector(width, 0)));
    ultimoPar = tActual; 
  }
}
