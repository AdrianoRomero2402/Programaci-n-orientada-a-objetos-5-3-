void keyPressed() {
  if (estadoDelJuego == INICIO) {
    if (key == 'f' || key == 'F') {
      inicializarFlappy();
      estadoDelJuego = FLAPPY;
    } 
    else if (key == 'p' || key == 'P') {
      estadoDelJuego = PONG;
    }
  } 
  else if (estadoDelJuego == GAME_OVER || estadoDelJuego == PONG) {
    if (key == ' ') {
      estadoDelJuego = INICIO;
    }
  }
}
void mousePressed() {
  if (estadoDelJuego == FLAPPY) {
    bird.addFuerza(salto);
  }
}
