int max=10;
float[]posX=new float[max];
float[]posY=new float[max];
int pos=0;
int c=0;
void setup(){
  size(800, 600);
}
void draw(){
  background(0);
  for (int i=0; i<c; i++){
    circle(posX[i], posY[i], 40);
  }
}
void mousePressed(){
  posX[pos]=mouseX;
  posY[pos]=mouseY;
/* if(c==10){
   indice =0;
  }*/
  pos=(pos+1)%max;
  if (c<max){
    c++;
  }
}
